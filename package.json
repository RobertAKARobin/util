{
	"devDependencies": {
		"@robertakarobin/csslint": "file:./csslint",
		"@robertakarobin/eslint-config": "file:./eslint-config",
		"@robertakarobin/eslint-config-json": "file:./eslint-config-json",
		"@robertakarobin/eslint-config-ts": "file:./eslint-config-ts",
		"@types/diff": "^6.0.0",
		"@types/node": "^22.10.2",
		"diff": "^7.0.0",
		"glob": "^11.0.0",
		"husky": "^9.1.7",
		"npm-check-updates": "^17.1.11",
		"tsx": "^4.19.2"
	},
	"engines": {
		"node": "23.6.0"
	},
	"name": "@robertakarobin/util",
	"repository": {
		"type": "git",
		"url": "https://github.com/RobertAKARobin/util"
	},
	"scripts": {
		"build": "bin/build.sh",
		"dev": "npm run dev --prefix example",
		"lint": "tsc && tsc -p example/tsconfig.json && eslint .",
		"lint:list": "DEBUG=eslint:eslint eslint .",
		"prepublishOnly": "npm run build",
		"spec": "npm run spec:node && npm run spec:web",
		"spec:node": "tsx index.spec.ts -platform=node $(glob util/**/*.spec?\\(.node\\).ts)",
		"spec:web": "rm -rf dist && mkdir dist && cp -pR util/mock dist && tsx index.spec.ts -platform=web $(glob util/**/*.spec?\\(.web\\).ts)",
		"test": "npm run lint && npm run test:rules && tsc && npm run spec && npm run test:example",
		"test:example": "npm run test --prefix example",
		"test:rules": "npm run test --prefix eslint-config && npm run test --prefix eslint-config-ts"
	},
	"type": "module",
	"version": "0.0.424"
}
