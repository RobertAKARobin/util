{
	"compilerOptions": {
		"baseUrl": ".",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "."
	},
	"exclude": [
		"csslint/index.js",
		"eslint-config/index.js",
		"eslint-config-html/index.js",
		"eslint-config-ts/index.js",
	],
	"extends": [
		"@robertakarobin/eslint-config-ts"
	],
	"include": [
		"csslint/**/*",
		"eslint-config/**/*",
		"eslint-config-html/**/*",
		"eslint-config-ts/**/*",
		"util/**/*",
		"index.spec.ts",
	],
}
